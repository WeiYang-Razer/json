{
  "name": "json",
  "version": "3.12.0.1",
  "schemaVersion": 2,
  "kind": "HeaderOnlyLib",
  "description": "nlohmann/json - JSON for Modern C++, header-only library with intuitive STL-like syntax",
  "dependencies": {},
  "build": {
    "system": "cmake",
    "generator": [
      "Ninja Multi-Config",
      "Visual Studio 17 2022",
      "Visual Studio 16 2019"
    ],
    "configs": [
      "Debug",
      "Release",
      "RelWithDebInfo",
      "MinSizeRel"
    ],
    "configure": [
      "-DJSON_BuildTests=OFF"
    ],
    "installDir": "install"
  },
  "compatibility": {
    "os": "exact",
    "arch": "exact",
    "compiler": "exact",
    "compiler.version": "exact-or-newer",
    "compiler.cppstd": "exact-or-newer",
    "compiler.runtime": "exact"
  }
}
